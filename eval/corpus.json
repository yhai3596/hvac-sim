{
  "_comment": "LLM 解析路径评测语料。expect 是对『编译结果』的断言，与解析器实现无关：arms/conds/base 是把计划序列化成 key=value 后做正则匹配；no* 为反向断言。",
  "cases": [
    {"id":"multi-dim","text":"对比自动风和二档风在不同热负荷，湿度负荷以及室内设定温度条件下，以及不同地区的影响",
     "expect":{"arms":["fanCtrl=auto","fanCtrl=two"],"conds":["sat=","vent=|mgain=","tset=","loc="],"maxRuns":24}},
    {"id":"fan-3way","text":"风量那三种模式——固定、两档、自动风，哪个达温最快",
     "expect":{"arms":["fanCtrl=fixed","fanCtrl=auto"],"minArms":3}},
    {"id":"fan-degenerate","text":"两档风的二档是不是多余的？固定 100% 跟两档风 PK 一下",
     "expect":{"arms":["fanCtrl=fixed"],"noArmsPair":["fanCtrl=fixed","twoStage=2"]}},
    {"id":"algo-reverse","text":"C算法跟B比一下，B 的目标 Tes 打 12",
     "expect":{"arms":["algo=B","algo=C"],"any":["tgtb=12"]}},
    {"id":"algo-inverter","text":"定频机和变频机各跑一版","expect":{"arms":["algo=A","algo=C"]}},
    {"id":"tcs-heating","text":"算法B的Tcs目标定46℃和50℃，再拉上C的自学习一起比，纽约冬天",
     "expect":{"any":["tgtb=46","tgtb=50","algo=C"],"base":["loc=new_york","scen=winter"],"noAny":["tgtb=4[^6]"]}},
    {"id":"aux-enum","text":"辅热3kw跟5kw哪个更值？波士顿冬设计日跑",
     "expect":{"arms":["aux=3","aux=5"],"base":["loc=boston","scen=winter_design"]}},
    {"id":"aux-onoff","text":"纽约冬天，想知道加辅热和不加辅热差在哪",
     "expect":{"arms":["aux=0"],"base":["loc=new_york"]}},
    {"id":"aux-off-premise","text":"winter design day，NY，UA大一档小一档、渗透0.5和1.0ACH，就用现在的C算法，别加辅热",
     "expect":{"base":["aux=0","algo=C","loc=new_york"],"any":["ua=","ach="],"noArms":["fanCtrl="],"noBase":["fanCtrl="]}},
    {"id":"db-enum","text":"回差1度跟3度对比一下","expect":{"arms":["db=1","db=3"]}},
    {"id":"bias-sign","text":"能力测量偏差 -10% 0 +10% 三档扫一下",
     "expect":{"arms":["bias=-10","bias=10"],"minArms":3}},
    {"id":"fmax-enum","text":"变频上限压到50Hz跟放到70Hz对比制热，波士顿冬设计日辅热固定3kW",
     "expect":{"arms":["fmax=50","fmax=70"],"base":["aux=3","loc=boston"]}},
    {"id":"quantifier-trap","text":"设定 24℃ 和 26℃ 两版对比，回差 2°F 带一档，停机风机常开也带一档",
     "expect":{"arms":["tset=24","tset=26"],"noBase":["fanCtrl="],"any":["fan=on","db=2"]}},
    {"id":"ta-out-of-range","text":"V1.44 的 TA 我想扫 6/8/10/12 四档；条件上再看看保温 poor/good 和满足度 80%、120%",
     "expect":{"arms":["ta="],"conds":["sat=80","ins="]}},
    {"id":"decay","text":"冬季典型日，低温下能力衰减20%和40%两种情况分别跑一下",
     "expect":{"arms":["sat=80","sat=60"],"base":["scen=winter"]}},
    {"id":"metric-word","text":"就现在这套参数不用改 迈阿密 奥兰多 休斯顿 三个地方各跑一遍 我想看看湿度到底能压到多少",
     "expect":{"any":["loc=miami","loc=orlando","loc=houston"],"noConds":["vent=","mgain="],"maxRuns":6}},
    {"id":"warmup-explicit","text":"客户老反馈达温慢，天数3天 预热2小时","expect":{"days":3,"warmup":2}},
    {"id":"add-cue","text":"顺便把保温差的房子也来一版","expect":{"conds":["ins=poor"],"noBase":["ins="]}},
    {"id":"english-enum","text":"两档风 vs auto风 vs 一直100%，仨方案，房子按medium，迈阿密",
     "expect":{"arms":["fanCtrl=fixed","fanCtrl=auto"],"minArms":3,"base":["loc=miami"]}},
    {"id":"keyname","text":"房间 qint 拉到1500W 的情况也带上","expect":{"any":["qint=1500"]}},
    {"id":"city-alias","text":"同样 3T 的机器装 LA 和休斯顿差多少",
     "expect":{"arms":["loc=los_angeles","loc=houston"]}},
    {"id":"colloquial-cfm","text":"客户投诉最多的还是达温慢，风量大一点小一点各跑一版",
     "expect":{"arms":["cfm="],"minArms":2}},
    {"id":"weather-contrast","text":"分设计日和普通热天两种天气",
     "expect":{"any":["scen=summer_design"],"noBase":["scen=summer_design"]}},
    {"id":"pre-switch","text":"预学习那功能到底有没有用？开和不开比一比，不同季节、负荷轻重、房子漏不漏风都覆盖到",
     "expect":{"arms":["pre=true","pre=false"],"conds":["scen=winter"]}}
  ]
}

# 大模型 API 反代的后端声明。复制到 /etc/hvac-sim/api.env 并填入真实 Key，然后重跑
# deploy/install.sh —— 脚本发现这个文件就会装上 hvac-sim-proxy 服务并在 nginx 里挂 /api/。
#
#   sudo mkdir -p /etc/hvac-sim
#   sudo cp deploy/api.env.example /etc/hvac-sim/api.env
#   sudo chmod 600 /etc/hvac-sim/api.env     # 只有 root 可读，install.sh 也会再确保一次
#   sudo nano /etc/hvac-sim/api.env
#
# 命名规则：AC_API_<名字>_URL / _KEY / _PROTOCOL，名字随便起，页面里 Base URL 填 /api/<小写名字>。
# 这个文件里的 Key 只存在服务器上，浏览器永远拿不到；不要把填好的版本提交进任何仓库。

AC_API_DEEPSEEK_URL=https://api.deepseek.com
AC_API_DEEPSEEK_KEY=sk-换成你的key
AC_API_DEEPSEEK_MODEL=deepseek-chat      # 会写进站点级配置，用户打开页面即已填好
AC_API_DEEPSEEK_LABEL=DeepSeek           # 页面上显示的名字，不填就用小写的名字
# AC_API_DEEPSEEK_PROTOCOL=openai        # 不填即 OpenAI 协议（注入 Authorization: Bearer）

# AC_API_CLAUDE_URL=https://api.anthropic.com
# AC_API_CLAUDE_KEY=sk-ant-换成你的key
# AC_API_CLAUDE_MODEL=claude-sonnet-4-5
# AC_API_CLAUDE_LABEL=Claude
# AC_API_CLAUDE_PROTOCOL=anthropic       # Anthropic 协议（注入 x-api-key + anthropic-version）

# 配好后重跑 deploy/install.sh：反代会挂上，同时生成 dist/config.json —— 任何电脑、
# 任何浏览器打开站点都自动带上这些配置，不必逐台再填。config.json 里只有 /api/<名字>
# 与占位 Key，真实 Key 只在本文件与反代进程里，浏览器永远拿不到。
